[
  {
    "pattern": "(?<![\\w./@\\\\-])[A-Za-z0-9._-]+@[A-Za-z0-9][A-Za-z0-9.-]*",
    "replace": "<user>@<host>"
  },
  {
    "pattern": "\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b",
    "replace": "x.x.x.x"
  },
  {
    "pattern": "[A-Za-z0-9-]+\\.dyndns\\.example",
    "replace": "dynamic-dns.example"
  },
  {
    "pattern": "/home/[A-Za-z0-9_.-]+",
    "replace": "~"
  },
  {
    "pattern": "/home/",
    "replace": "~/"
  },
  {
    "pattern": "(?i)\\bcrm-(api|web)\\b",
    "replace": "work-app"
  },
  {
    "pattern": "(?i)PROJ-",
    "replace": "TICKET-"
  }
]
